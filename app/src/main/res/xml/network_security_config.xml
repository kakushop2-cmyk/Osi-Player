<?xml version="1.0" encoding="utf-8"?>
<!--
    IPTV-Anbieter liefern ihre Streams häufig ausschließlich über HTTP.
    Deshalb ist Cleartext für die vom Nutzer konfigurierten Server erlaubt.
    Die App selbst betreibt keine eigenen Server und überträgt keine Daten
    an den Entwickler.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
